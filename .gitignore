.DS_Store
xcuserdata/
DerivedData/
build/
.build/
.swiftpm/
*.xcodeproj/project.xcworkspace/xcuserdata/

# Build-time dependency caches (reproducible from lock files)
Resources/Runner/build/
Resources/Sandbox/laravel/vendor/
Resources/Sandbox/laravel/node_modules/
Resources/Sandbox/laravel/.env
Resources/Sandbox/laravel/storage/logs/*.log
Resources/Sandbox/laravel/storage/framework/views/*.php
Resources/Sandbox/laravel/storage/framework/cache/data/
Resources/Sandbox/laravel/storage/framework/sessions/*
!Resources/Sandbox/laravel/storage/framework/sessions/.gitignore
# Pinned PHPantom binaries are downloaded and checksum-verified by scripts/fetch-phpantom.sh
Resources/LSP/phpantom_lsp
Resources/LSP/*.tar.gz
# The pinned Mago formatter is downloaded and checksum-verified by scripts/fetch-mago.sh (#36)
Resources/Formatter/mago
Tests/Fixtures/*/vendor/
Tests/Fixtures/laravel-app/
/dist/
# Generated by scripts/setup-fixtures.sh (WordPress on SQLite, Symfony skeleton)
Tests/Fixtures/wordpress/
Tests/Fixtures/symfony-app/
# Throwaway TLS certificates and keys for the database fixtures (#140): their copy from before
# #176, or outside a Git checkout. setup-fixtures.sh keeps them in .git/runlet-fixtures/tls.
Tests/Fixtures/docker/tls/

# Agent worktrees
/.claude/

# Test fixtures intentionally commit .runlet/ folders (often ignored globally)
!.runlet/
